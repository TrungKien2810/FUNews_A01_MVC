@{
    ViewData["Title"] = "Access denied";
}
<div class="page-head">
    <div class="page-head__text">
        <span class="kicker">Not permitted</span>
        <h1 class="page-head__title">Access denied</h1>
    </div>
</div>

<div class="panel">
