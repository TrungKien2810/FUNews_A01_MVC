@model (string Title, List<NewsStatistic> Rows)
<section class="breakdown__col">
    <h3 class="breakdown__title">@Model.Title</h3>
    @if (Model.Rows.Count == 0)
    {
        <p class="muted small">No article was created in this period.</p>
    }
    else
    {
        <div class="ledger__scroll">
            <table class="ledger ledger--compact ledger--plain">
                <thead>
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col" class="is-num">Total</th>
                        <th scope="col" class="is-num">Active</th>
                        <th scope="col" class="is-num">Inactive</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td class="ledger__group">@row.GroupName</td>
                            <td class="is-num ledger__num">@row.Total</td>
                            <td class="is-num ledger__num">@row.Active</td>
                            <td class="is-num ledger__num">@row.Inactive</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
