@model NewsDetailViewModel
@using TrungKienMVC.Infrastructure
@{
    var article = Model.Article;
    var categoryName = article.Category?.CategoryName ?? "Uncategorised";

    ViewData["Title"] = article.NewsTitle;
    ViewData["Description"] = string.IsNullOrWhiteSpace(article.Headline) ? article.NewsTitle : article.Headline;
    ViewData["OgType"] = "article";

    var published = article.CreatedDate;
    // A story from this week is worth a clock; an older one is a date, and the time only
    // makes the line longer.
    var isFresh = published.HasValue && (DateTime.Now - published.Value).TotalDays <= 7;
    var publishedLabel = published?.ToString(isFresh ? "dd MMM yyyy, HH:mm" : "dd MMM yyyy");
    var minutes = ReadTime.Minutes(article.NewsContent);
    var hasHeadline = !string.Equals(article.Headline?.Trim(), article.NewsTitle?.Trim(), StringComparison.OrdinalIgnoreCase);
}

<nav aria-label="Breadcrumb">
    <ol class="breadcrumb">
        <li><a asp-action="Index">News</a></li>
        <li>@categoryName</li>
    </ol>
</nav>

<article class="article">
    <span class="kicker">@categoryName</span>
    <h1 class="article__title">@article.NewsTitle</h1>
    @if (hasHeadline)
    {
        <p class="article__headline">@article.Headline</p>
    }

    <div class="article__meta">
        <span class="article__byline">By <strong>@(article.CreatedBy?.AccountName ?? "Unknown author")</strong></span>
        @if (published.HasValue)
        {
            <time datetime="@published.Value.ToString("o")">@publishedLabel</time>
        }
        <span>@minutes min read</span>
        @if (article.ModifiedDate.HasValue)
        {
            <span>Updated @article.ModifiedDate.Value.ToString("dd MMM yyyy, HH:mm")</span>
        }
        @if (!string.IsNullOrWhiteSpace(article.NewsSource))
        {
            <span>Source: @article.NewsSource</span>
        }
        <button type="button" class="link-action article__share" data-copy-link>Copy link</button>
    </div>

    <div class="news-content">@article.NewsContent</div>

    @if (article.Tags.Any())
    {
        <div class="article__tags">
            <span class="kicker">Filed under</span>
            <ul class="chip-list">
                @foreach (var tag in article.Tags)
                {
                    <li>
                        <a class="chip" asp-action="Index" asp-route-tagId="@tag.TagId">@tag.TagName</a>
                    </li>
                }
            </ul>
        </div>
    }

    <div class="cluster article__foot">
        <a class="btn btn-secondary" asp-action="Index">Back to news</a>
        <a class="link-more" href="#top">Back to top</a>
    </div>

    <p class="visually-hidden" role="status" aria-live="polite" data-copy-status></p>
</article>

@if (Model.Related.Any())
{
    <section class="related" aria-labelledby="related-title">
        <h2 class="related__title" id="related-title">More from @categoryName</h2>
        <ul class="related__list">
            @foreach (var story in Model.Related)
            {
                <li class="related__item">
                    <a class="related__link" asp-action="Details" asp-route-id="@story.NewsArticleId">@story.NewsTitle</a>
                    <p class="related__meta">
                        <time datetime="@story.CreatedDate?.ToString("yyyy-MM-dd")">@story.CreatedDate?.ToString("dd MMM yyyy")</time>
                        <span aria-hidden="true">·</span>
                        <span>@ReadTime.Minutes(story.NewsContent) min read</span>
                    </p>
                </li>
            }
        </ul>
        <a class="link-more" asp-action="Index" asp-route-categoryId="@article.CategoryId">See every story in @categoryName</a>
    </section>
}
