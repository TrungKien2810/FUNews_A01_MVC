@model AccountFormViewModel
<form asp-action="@(Model.IsEdit ? "Edit" : "Create")" method="post" data-ajax-form novalidate>
    <partial name="_ModalHeader" model="@(Model.IsEdit ? "Edit account" : "New account")" />
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly"></div>
        <input type="hidden" asp-for="AccountId" />

        @if (Model.IsEdit)
        {
            <div class="field">
                <label class="field__label" for="accountIdDisplay">@Html.DisplayNameFor(m => m.AccountId)</label>
                <input id="accountIdDisplay" class="form-control" value="@Model.AccountId" disabled />
                <span class="field__hint">Assigned by the database — it cannot be changed.</span>
            </div>
        }

        <div class="field">
            <label asp-for="AccountName" class="field__label">@Html.DisplayNameFor(m => m.AccountName)<span class="req" aria-hidden="true"> *</span></label>
            <input asp-for="AccountName" class="form-control" required maxlength="100" autocomplete="name" />
            <span asp-validation-for="AccountName" class="field-validation-error"></span>
        </div>

        <div class="field">
            <label asp-for="AccountEmail" class="field__label">@Html.DisplayNameFor(m => m.AccountEmail)<span class="req" aria-hidden="true"> *</span></label>
            <input asp-for="AccountEmail" class="form-control" required maxlength="70" autocomplete="email" />
            <span asp-validation-for="AccountEmail" class="field-validation-error"></span>
        </div>

        <div class="field">
            <label asp-for="AccountRole" class="field__label">@Html.DisplayNameFor(m => m.AccountRole)<span class="req" aria-hidden="true"> *</span></label>
            <select asp-for="AccountRole" class="form-select" required>
                <option value="">Select a role</option>
                <option value="@AccountRoles.Staff">Staff — writes and files news</option>
                <option value="@AccountRoles.Lecturer">Lecturer — reads active news</option>
            </select>
            <span asp-validation-for="AccountRole" class="field-validation-error"></span>
        </div>

        <div class="field__row">
            <div class="field">
                <label asp-for="AccountPassword" class="field__label">
                    @Html.DisplayNameFor(m => m.AccountPassword)@if (!Model.IsEdit)
                    {<span class="req" aria-hidden="true"> *</span>}
                </label>
                <input asp-for="AccountPassword" class="form-control" required="@(!Model.IsEdit)"
                       maxlength="70" autocomplete="new-password" />
                <span class="field__hint">@(Model.IsEdit ? "Leave blank to keep the current password." : "At least 2 characters.")</span>
                <span asp-validation-for="AccountPassword" class="field-validation-error"></span>
            </div>
            <div class="field">
                <label asp-for="ConfirmPassword" class="field__label"></label>
                <input asp-for="ConfirmPassword" class="form-control" maxlength="70" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">@(Model.IsEdit ? "Save changes" : "Create account")</button>
    </div>
</form>
