@model NewsArticle
<form asp-action="Delete" asp-route-id="@Model.NewsArticleId" method="post" data-ajax-form>
    <partial name="_ModalHeader" model="@("Delete article")" />
    <div class="modal-body">
        <div class="alert alert-danger d-none ajax-error" role="alert" tabindex="-1"></div>
        <p>Deleting removes the article and its tag links. This cannot be undone.</p>
        <dl class="definition">
            <dt>ID</dt>
            <dd class="mono">@Model.NewsArticleId</dd>
            <dt>Title</dt>
            <dd>@Model.NewsTitle</dd>
            <dt>Category</dt>
            <dd>@(Model.Category?.CategoryName ?? "—")</dd>
            <dt>Created</dt>
            <dd class="mono">@Model.CreatedDate?.ToString("dd/MM/yyyy")</dd>
        </dl>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-danger">Delete article</button>
    </div>
</form>
