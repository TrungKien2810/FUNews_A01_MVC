@model ProfileViewModel
<form asp-action="Edit" method="post" data-ajax-form novalidate>
    <partial name="_ModalHeader" model="@("Edit my profile")" />
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly"></div>
        <input type="hidden" asp-for="AccountId" />

        <div class="field">
            <label asp-for="AccountName" class="field__label">@Html.DisplayNameFor(m => m.AccountName)<span class="req" aria-hidden="true"> *</span></label>
            <input asp-for="AccountName" class="form-control" required maxlength="100" autocomplete="name" />
            <span asp-validation-for="AccountName" class="field-validation-error"></span>
        </div>

        <div class="field">
            <label asp-for="AccountEmail" class="field__label">@Html.DisplayNameFor(m => m.AccountEmail)<span class="req" aria-hidden="true"> *</span></label>
            <input asp-for="AccountEmail" class="form-control" required maxlength="70" autocomplete="email" />
            <span asp-validation-for="AccountEmail" class="field-validation-error"></span>
        </div>

        <div class="field">
            <label asp-for="CurrentPassword" class="field__label">@Html.DisplayNameFor(m => m.CurrentPassword)<span class="req" aria-hidden="true"> *</span></label>
            <input asp-for="CurrentPassword" class="form-control" required maxlength="70" autocomplete="current-password" />
            <span class="field__hint">Required on every save, even when only the name changes.</span>
            <span asp-validation-for="CurrentPassword" class="field-validation-error"></span>
        </div>

        <div class="field__row">
            <div class="field">
                <label asp-for="NewPassword" class="field__label"></label>
                <input asp-for="NewPassword" class="form-control" maxlength="70" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="field-validation-error"></span>
            </div>
            <div class="field">
                <label asp-for="ConfirmNewPassword" class="field__label"></label>
                <input asp-for="ConfirmNewPassword" class="form-control" maxlength="70" autocomplete="new-password" />
                <span asp-validation-for="ConfirmNewPassword" class="field-validation-error"></span>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save changes</button>
    </div>
</form>
