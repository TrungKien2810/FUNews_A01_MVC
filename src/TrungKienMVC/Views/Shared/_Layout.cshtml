@{
    var currentController = ViewContext.RouteData.Values["controller"] as string;
    var currentAction = ViewContext.RouteData.Values["action"] as string;

    // Returns "page" only for the nav item that is actually current; null makes Razor
    // drop the attribute entirely, which is what "no aria-current" is supposed to mean.
    string? Current(string controller, string? action = null)
    {
        if (!string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)) return null;
        if (action is not null && !string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase)) return null;
        return "page";
    }

    var pageTitle = ViewData["Title"] as string;
    var isAuthenticated = User.Identity?.IsAuthenticated == true;

    var roleName = User.IsInRole(AccountRoles.AdminName) ? AccountRoles.AdminName
        : User.IsInRole(AccountRoles.StaffName) ? AccountRoles.StaffName
        : AccountRoles.LecturerName;
    var roleClass = roleName == AccountRoles.AdminName ? "role--admin"
        : roleName == AccountRoles.StaffName ? "role--staff"
        : "role--lecturer";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>@(string.IsNullOrEmpty(pageTitle) ? "FUNews — Newsroom desk" : $"{pageTitle} · FUNews")</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <header class="masthead">
        <div class="wrap masthead__inner">
            <a class="masthead__brand" asp-controller="Home" asp-action="Index">
                <span class="masthead__mark">FUNews</span>
                <span class="masthead__kicker">Newsroom desk</span>
            </a>

            <nav class="masthead__nav" aria-label="Main">
                <ul class="nav-list">
                    <li>
                        <a asp-controller="News" asp-action="Index" aria-current="@Current("News", "Index")">News</a>
                    </li>
                    @if (User.IsInRole(AccountRoles.AdminName))
                    {
                        <li>
                            <a asp-controller="SystemAccounts" asp-action="Index" aria-current="@Current("SystemAccounts")">Accounts</a>
                        </li>
                        <li>
                            <a asp-controller="Report" asp-action="Index" aria-current="@Current("Report")">Report</a>
                        </li>
                    }
                    @if (User.IsInRole(AccountRoles.StaffName))
                    {
                        <li>
                            <a asp-controller="NewsArticles" asp-action="Index" aria-current="@Current("NewsArticles", "Index")">News desk</a>
                        </li>
                        <li>
                            <a asp-controller="Categories" asp-action="Index" aria-current="@Current("Categories")">Categories</a>
                        </li>
                        <li>
                            <a asp-controller="NewsArticles" asp-action="History" aria-current="@Current("NewsArticles", "History")">My history</a>
                        </li>
                        <li>
                            <a asp-controller="Profile" asp-action="Index" aria-current="@Current("Profile")">Profile</a>
                        </li>
                    }
                </ul>
            </nav>

            <div class="masthead__user">
                @if (isAuthenticated)
                {
                    <span class="masthead__who">
                        <span class="masthead__name" title="@User.Identity!.Name">@User.Identity.Name</span>
                        <span class="role @roleClass">@roleName</span>
                    </span>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="btn btn-secondary btn-sm">Log out</button>
                    </form>
                }
                else
                {
                    <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Login">Log in</a>
                }
            </div>
        </div>
    </header>

    <main id="main" class="wrap">
        <div class="visually-hidden" aria-live="polite">
            @if (TempData["Success"] is string announced)
            {
                @announced
            }
        </div>

        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success flash" role="status">
                <span>@success</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Dismiss message"></button>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger flash" role="alert">
                <span>@error</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Dismiss message"></button>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="site-foot">
        <div class="wrap site-foot__inner">
            <span>&copy; @DateTime.Now.Year FUNewsManagementSystem</span>
            <span class="site-foot__meta">ASP.NET Core MVC · Service → Repository → DAO</span>
        </div>
    </footer>

    @* Shared popup for Create / Edit / Delete / Details. Labelled by the title the
       partial renders (#appModalTitle), so the dialog announces itself. *@
    <div class="modal fade" id="appModal" tabindex="-1" role="dialog" aria-modal="true"
         aria-labelledby="appModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-centered">
            <div class="modal-content"></div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
